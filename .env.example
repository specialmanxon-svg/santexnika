# ==============================================================================
# DIYORGROUP AI-ECOSYSTEM (v2.4) — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. МОЙСКЛАД API (MDM, СКЛАДСКОЙ УЧЕТ И ЦЕНООБРАЗОВАНИЕ)
# ------------------------------------------------------------------------------
# Способ 1: Авторизация по Bearer-токену (Рекомендуется)
# Получить можно в МойСклад: Настройки -> Пользователи -> Токены
MOYSKLAD_TOKEN=

# Способ 2: Авторизация по Логину и Паролю (Basic Auth)
# Заполните, если используете логин и пароль вместо токена
MOYSKLAD_LOGIN=
MOYSKLAD_PASSWORD=

# URL API МойСклад (по умолчанию Remap 1.2)
MOYSKLAD_API_URL=https://api.moysklad.ru/api/remap/1.2

# UUID Юрлица (Организации) в МойСклад
MOYSKLAD_ORGANIZATION_ID=

# UUID статуса резерва («В резерве» / «Счет выставлен») для CustomerOrder
MOYSKLAD_RESERVE_STATE_ID=

# ------------------------------------------------------------------------------
# 2. DIYORGROUP NATIVE CRM (https://diyorgroup.uz/crm/)
# ------------------------------------------------------------------------------
DIYORGROUP_CRM_URL=https://diyorgroup.uz/crm
DIYORGROUP_CRM_API_KEY=diyor_crm_live_api_key_2026
DIYORGROUP_CRM_WEBHOOK_SECRET=diyor_crm_webhook_secret_key

# ------------------------------------------------------------------------------
# 3. БАЗА ДАННЫХ И ОЧЕРЕДИ (PostgreSQL / SQLite fallback)
# ------------------------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./diyorgroup.db
DATABASE_URL_SYNC=sqlite:///./diyorgroup.db
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# ------------------------------------------------------------------------------
# 4. ИИ-АГЕНТЫ (OPENAI GPT-4o)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ------------------------------------------------------------------------------
# 5. TELEGRAM-БОТ И УВЕДОМЛЕНИЯ
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=-1001234567890
TELEGRAM_CEO_CHAT_ID=123456789

# ------------------------------------------------------------------------------
# 6. БЕЗОПАСНОСТЬ И ОКРУЖЕНИЕ СЕРВЕРА
# ------------------------------------------------------------------------------
APP_ENV=development
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
SECRET_KEY=super-secret-diyorgroup-key-32chars!
SUPERUSER_TOKEN=diyor-admin-superuser-token
