# === Database ===
DATABASE_URL=postgresql+asyncpg://diyorgroup:changeme@db:5432/diyorgroup
DATABASE_URL_SYNC=postgresql://diyorgroup:changeme@db:5432/diyorgroup
POSTGRES_USER=diyorgroup
POSTGRES_PASSWORD=changeme
POSTGRES_DB=diyorgroup

# === Redis ===
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# === Bitrix24 ===
BITRIX24_DOMAIN=https://diyorgroup.bitrix24.ru
BITRIX24_WEBHOOK_USER_ID=1
BITRIX24_WEBHOOK_SECRET=your_webhook_secret_here
BITRIX24_APPLICATION_TOKEN=your_application_token_here

# === MoySklad ===
MOYSKLAD_API_URL=https://api.moysklad.ru/api/remap/1.2
MOYSKLAD_TOKEN=your_moysklad_bearer_token_here
MOYSKLAD_ORGANIZATION_ID=your_org_uuid_here
MOYSKLAD_RESERVE_STATE_ID=your_reserve_state_uuid_here

# === OpenAI ===
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_LLM_MODEL=gpt-4o

# === Telegram ===
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ALERT_CHAT_ID=-1001234567890
TELEGRAM_CEO_CHAT_ID=123456789

# === Security ===
SECRET_KEY=your-secret-key-for-jwt-and-hmac
OTP_SECRET=your-totp-base32-secret
SUPERUSER_TOKEN=your-superuser-bearer-token

# === App ===
APP_ENV=production
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
